{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/paper-trading?run=1&phase=sell",
      "schedule": "35 1 * * 1-5"
    },
    {
      "path": "/api/paper-trading?run=1&phase=buy",
      "schedule": "45 6 * * 1-5"
    }
  ]
}
